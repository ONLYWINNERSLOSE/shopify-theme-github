{% assign link_url = section.settings.link_url %}
{% assign open_new_tab = section.settings.open_new_tab %}

<style>
  #section-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  #section-{{ section.id }} a.media-link,
  #section-{{ section.id }} div.media-link {
    display: block;
    position: relative;
    width: 100%;
  }
  #section-{{ section.id }} .media-wrap {
    width: 100%;
    display: block;
    position: relative;
  }
  #section-{{ section.id }} .media-wrap img,
  #section-{{ section.id }} .media-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  {% if section.settings.height_type_desktop == 'fullscreen' %}
  #section-{{ section.id }} .media-desktop { height: 100vh; }
  {% else %}
  #section-{{ section.id }} .media-desktop { height: {{ section.settings.height_desktop }}px; }
  {% endif %}

  {% if section.settings.height_type_mobile == 'fullscreen' %}
  #section-{{ section.id }} .media-mobile { height: 100vh; }
  {% else %}
  #section-{{ section.id }} .media-mobile { height: {{ section.settings.height_mobile }}px; }
  {% endif %}

  #section-{{ section.id }} .media-mobile { display: none; }

  #section-{{ section.id }} .media-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.text_vertical_align }};
    align-items: {{ section.settings.text_horizontal_align }};
    text-align: {{ section.settings.text_align }};
    padding: {{ section.settings.overlay_padding }}px;
    box-sizing: border-box;
    pointer-events: none;
    gap: 0;
  }

  #section-{{ section.id }} .overlay-block {
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  #section-{{ section.id }} .overlay-block.type-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    text-transform: var(--font-heading-text-transform, none);
    letter-spacing: var(--font-heading-letter-spacing, normal);
    text-shadow: 0 2px 10px rgba(0,0,0,0.35);
  }

  #section-{{ section.id }} .overlay-block.type-subheading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    opacity: 0.85;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  #section-{{ section.id }} .overlay-block.type-text {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    text-shadow: 0 1px 6px rgba(0,0,0,0.25);
  }

  #section-{{ section.id }} .overlay-content {
    max-width: 100%;
  }
  #section-{{ section.id }} .overlay-content.is-split {
    display: grid;
    width: max-content;
    max-width: 100%;
    min-width: 0;
  }
  #section-{{ section.id }} .overlay-content.is-split .type-heading {
    line-height: 1;
    overflow-wrap: anywhere;
  }
  #section-{{ section.id }} .overlay-block.type-subheading {
    line-height: 1.2;
    margin-top: {{ section.settings.subtitle_gap | default: 0 }}px;
  }
  #section-{{ section.id }} .overlay-block.split-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 12px;
    width: 0;
    min-width: 100%;
    box-sizing: border-box;
  }
  #section-{{ section.id }} .split-text__left,
  #section-{{ section.id }} .split-text__right {
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: var(--split-size-desktop, inherit);
  }
  #section-{{ section.id }} .split-text__left { text-align: left; }
  #section-{{ section.id }} .split-text__right { text-align: right; }

  @media (max-width: 767px) {
    #section-{{ section.id }} .split-text > span { font-size: var(--split-size-mobile, inherit); }
    #section-{{ section.id }} .media-desktop { display: none; }
    #section-{{ section.id }} .media-mobile { display: block; }
  }
</style>

{%- liquid
  assign overlay_html = ''
  assign has_split_text = false
  for block in section.blocks
    assign font_size_desktop = block.settings.font_size_desktop
    assign font_size_mobile = block.settings.font_size_mobile
    assign block_color = block.settings.block_color
    assign margin_bottom = block.settings.margin_bottom

    assign fw = 'inherit'
    if block.settings.bold
      assign fw = 'bold'
    endif

    assign fs = 'normal'
    if block.settings.italic
      assign fs = 'italic'
    endif

    assign td = 'none'
    if block.settings.underline
      assign td = 'underline'
    endif

    assign tt = 'none'
    if block.settings.uppercase
      assign tt = 'uppercase'
    endif

    assign ls = 'normal'
    if block.settings.letter_spacing > 0
      assign ls = block.settings.letter_spacing | append: 'px'
    endif

    assign block_style = 'font-size:' | append: font_size_desktop | append: 'px;'
    assign block_style = block_style | append: 'font-weight:' | append: fw | append: ';'
    assign block_style = block_style | append: 'font-style:' | append: fs | append: ';'
    assign block_style = block_style | append: 'text-decoration:' | append: td | append: ';'
    assign block_style = block_style | append: 'text-transform:' | append: tt | append: ';'
    assign block_style = block_style | append: 'letter-spacing:' | append: ls | append: ';'
    assign block_style = block_style | append: 'margin-bottom:' | append: margin_bottom | append: 'px;'

    if block_color != blank
      assign block_style = block_style | append: 'color:' | append: block_color | append: ';'
    endif

    assign mobile_style_tag = '<style>@media(max-width:767px){#section-' | append: section.id | append: ' [data-block="' | append: block.id | append: '"]{font-size:' | append: font_size_mobile | append: 'px!important;}}</style>'

    if block.type == 'heading'
      assign overlay_html = overlay_html | append: mobile_style_tag
      assign overlay_html = overlay_html | append: '<p class="overlay-block type-heading" data-block="' | append: block.id | append: '" style="' | append: block_style | append: '">' | append: block.settings.text | append: '</p>'
    elsif block.type == 'subheading'
      assign overlay_html = overlay_html | append: mobile_style_tag
      if block.settings.split_text
        assign has_split_text = true
        assign left_text = block.settings.text_left | escape
        assign right_text = block.settings.text_right | escape
        assign split_block_style = block_style | replace: 'text-decoration:underline;', 'text-decoration:none;'
        assign text_sides = 'left,right' | split: ','
        for side in text_sides
          assign side_style = 'text-decoration:' | append: td | append: ';'
          assign customize_key = 'customize_' | append: side
          if block.settings[customize_key]
            assign weight_key = side | append: '_bold'
            assign italic_key = side | append: '_italic'
            assign underline_key = side | append: '_underline'
            assign uppercase_key = side | append: '_uppercase'
            assign color_key = side | append: '_color'
            assign desktop_key = side | append: '_size_desktop'
            assign mobile_key = side | append: '_size_mobile'
            assign spacing_key = side | append: '_letter_spacing'
            assign side_weight = 'normal'
            assign side_italic = 'normal'
            assign side_decoration = 'none'
            assign side_case = 'none'
            if block.settings[weight_key]
              assign side_weight = 'bold'
            endif
            if block.settings[italic_key]
              assign side_italic = 'italic'
            endif
            if block.settings[underline_key]
              assign side_decoration = 'underline'
            endif
            if block.settings[uppercase_key]
              assign side_case = 'uppercase'
            endif
            assign side_style = 'font-weight:' | append: side_weight | append: ';font-style:' | append: side_italic | append: ';text-decoration:' | append: side_decoration | append: ';text-transform:' | append: side_case | append: ';'
            assign side_style = side_style | append: '--split-size-desktop:' | append: block.settings[desktop_key] | append: 'px;--split-size-mobile:' | append: block.settings[mobile_key] | append: 'px;'
            assign side_style = side_style | append: 'letter-spacing:' | append: block.settings[spacing_key] | append: 'px;'
            if block.settings[color_key] != blank
              assign side_style = side_style | append: 'color:' | append: block.settings[color_key] | append: ';'
            endif
          endif
          if side == 'left'
            assign left_style = side_style
          else
            assign right_style = side_style
          endif
        endfor
        assign overlay_html = overlay_html | append: '<div class="overlay-block type-subheading split-text" data-block="' | append: block.id | append: '" style="' | append: split_block_style | append: '" ' | append: block.shopify_attributes | append: '><span class="split-text__left" style="' | append: left_style | append: '">' | append: left_text | append: '</span><span class="split-text__right" style="' | append: right_style | append: '">' | append: right_text | append: '</span></div>'
      else
        assign overlay_html = overlay_html | append: '<p class="overlay-block type-subheading" data-block="' | append: block.id | append: '" style="' | append: block_style | append: '">' | append: block.settings.text | append: '</p>'
      endif
    elsif block.type == 'text'
      assign overlay_html = overlay_html | append: mobile_style_tag
      assign overlay_html = overlay_html | append: '<p class="overlay-block type-text" data-block="' | append: block.id | append: '" style="' | append: block_style | append: '">' | append: block.settings.text | append: '</p>'
    endif
  endfor
-%}

<div id="section-{{ section.id }}">
  {% if link_url != blank %}
    <a class="media-link" href="{{ link_url }}"{% if open_new_tab %} target="_blank" rel="noopener"{% endif %}>
  {% else %}
    <div class="media-link">
  {% endif %}

  {%- comment -%} DESKTOP {%- endcomment -%}
  <div class="media-wrap media-desktop">
    {% if section.settings.media_type_desktop == 'image' %}
      {% if section.settings.image_desktop != blank %}
        {{ section.settings.image_desktop | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.image_desktop.alt }}
      {% endif %}
    {% elsif section.settings.media_type_desktop == 'video' %}
      {% if section.settings.video_url_desktop != blank %}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url_desktop }}" type="video/mp4">
        </video>
      {% endif %}
    {% endif %}
    {% if overlay_html != blank %}
      <div class="media-overlay"><div class="overlay-content{% if has_split_text %} is-split{% endif %}">{{ overlay_html }}</div></div>
    {% endif %}
  </div>

  {%- comment -%} MOBILE {%- endcomment -%}
  <div class="media-wrap media-mobile">
    {% if section.settings.media_type_mobile == 'image' %}
      {% if section.settings.image_mobile != blank %}
        {{ section.settings.image_mobile | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.image_mobile.alt }}
      {% endif %}
    {% elsif section.settings.media_type_mobile == 'video' %}
      {% if section.settings.video_url_mobile != blank %}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url_mobile }}" type="video/mp4">
        </video>
      {% endif %}
    {% endif %}
    {% if overlay_html != blank %}
      <div class="media-overlay"><div class="overlay-content{% if has_split_text %} is-split{% endif %}">{{ overlay_html }}</div></div>
    {% endif %}
  </div>

  {% if link_url != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</div>

{% schema %}
